# Resend API key for the Contact and Franchise forms (key name in Resend: Balzac_Groupe). Never commit a real key.
RESEND_API_KEY=
# Inbox that receives Contact and Franchise form submissions. Server-side only, never rendered. Never hardcoded.
CONTACT_TO_EMAIL=
# Optional sender on the Resend-verified domain. Defaults to "Groupe Balzac <site@balzacgroupe.com>".
RESEND_FROM_EMAIL=
# Cloudflare Turnstile keys for the captcha on both forms. Captcha is on only when both are set;
# without them the forms still send (honeypot and rate limit only) and the server logs that captcha is unconfigured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
