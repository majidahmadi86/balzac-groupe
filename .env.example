# Resend API key for the Contact and Franchise forms (key name in Resend: Balzac_Groupe). Never commit a real key.
RESEND_API_KEY=
# Inbox that receives Contact and Franchise form submissions. Never hardcoded.
CONTACT_TO_EMAIL=
# Optional sender on the Resend-verified domain. Defaults to "Groupe Balzac <site@balzacgroupe.com>".
RESEND_FROM_EMAIL=
