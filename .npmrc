# sharp ships its native binary as a platform-specific optional dependency (@img/sharp-linux-x64 and
# friends). A server that installs with --omit=optional, or with omit=optional in its own npm config,
# gets the sharp package without its binary: Next then cannot load it and silently falls back to a
# slower image path. include wins over omit, so this keeps a deploy honest whatever the server config.
include=optional
